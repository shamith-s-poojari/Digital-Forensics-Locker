# ---------------------------------------------------------------------------------------------------------
# SERVER-SIDE ONLY. Read by server/pinataProxy.js through vite.config.js, never by the browser bundle.
# NEVER prefix a secret with VITE_: Vite copies VITE_* variables into the public JavaScript bundle.
# ---------------------------------------------------------------------------------------------------------
# Pinata API key (JWT) with only the pinFileToIPFS permission. Placeholder, not a real value.
PINATA_JWT=

# Master key that wraps every evidence file's decryption key (server/keyStore.js). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSING THIS KEY MAKES EVERY ENCRYPTED FILE UNREADABLE. Back it up somewhere other than this machine.
EVIDENCE_MASTER_KEY=
# Bump when rotating the master key (each stored key records the version that wrapped it).
EVIDENCE_MASTER_KEY_VERSION=1
# Where wrapped keys and the key-release log are kept (defaults shown; .data/ is gitignored).
EVIDENCE_KEY_STORE=.data/evidence-keys.json
EVIDENCE_KEY_ACCESS_LOG=.data/key-access.log
# Where the case store keeps case titles, descriptions and their version history (server/caseStore.js).
CASE_STORE=.data/cases.json
# Where access requests from wallets with no role are kept (server/accessRequests.js).
ACCESS_REQUEST_STORE=.data/access-requests.json
# Folder for the three stores above when their own variables are not set. On Railway, point it at the volume
# (for example /data): if the key store is lost, every encrypted evidence file becomes unreadable.
DATA_DIR=.data
# JSON-RPC endpoint the server uses to read wallets' roles from the contract (server/chainRoles.js), e.g. an Alchemy
# or Infura Sepolia URL. Required whenever VITE_LOCKER_ADDRESS is set: without it the API refuses every request.
# Server-side only (no VITE_ prefix): the URL usually contains your provider API key.
RPC_URL=

# ---------------------------------------------------------------------------------------------------------
# PUBLIC build-time settings (these DO end up in the browser, which is fine: none of them is a secret).
# Printed by `npx hardhat run scripts/deploy.ts` in contracts/ after a deployment.
# Leave VITE_LOCKER_ADDRESS empty to run the in-memory demo ledger (development builds only; a production
# build with no address denies access to everyone).
# ---------------------------------------------------------------------------------------------------------
VITE_LOCKER_ADDRESS=
VITE_CHAIN_ID=11155111
VITE_LOCKER_DEPLOY_BLOCK=
# Optional. Defaults to the Sepolia or Mainnet Etherscan for those chain ids.
VITE_EXPLORER_URL=
# Optional. IPFS gateways tried in order when verifying a stored copy (comma-separated, HTTPS).
VITE_IPFS_GATEWAYS=

# Demo ledger only (VITE_LOCKER_ADDRESS empty): which of YOUR wallet addresses hold which role. Any wallet not
# listed here has no role: it sees "Access Denied" and can request a role from the Chief. Public values.
# Optional: with VITE_DEMO_CHIEF empty, the first wallet can claim the Chief role from the Access Denied screen.
# Roles granted or claimed in the app are lost when the page is reloaded; the ones listed here are not.
# Listed wallets join the first demo branch ("Central Lab"); an address holds one branch role (first list wins).
VITE_DEMO_CHIEF=
VITE_DEMO_ADMINS=
VITE_DEMO_INVESTIGATORS=
VITE_DEMO_AUDITORS=

# Optional, any ledger: display names for wallet addresses, shown next to the address across the app. Labels only,
# they grant nothing, and they are public (in the page): use role names like "Investigator 1", not people's names.
# Comma-separated "0xAddress=Name" pairs.
VITE_ACCOUNT_NAMES=
