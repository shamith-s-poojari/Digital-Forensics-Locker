# ---------------------------------------------------------------------------------------------------------
# SERVER-SIDE ONLY. Read by server/pinataProxy.js through vite.config.js, never by the browser bundle.
# NEVER prefix a secret with VITE_: Vite copies VITE_* variables into the public JavaScript bundle.
# ---------------------------------------------------------------------------------------------------------
# Pinata API key (JWT) with only the pinFileToIPFS permission. Placeholder, not a real value.
PINATA_JWT=

# ---------------------------------------------------------------------------------------------------------
# PUBLIC build-time settings (these DO end up in the browser, which is fine: none of them is a secret).
# Printed by `npx hardhat run scripts/deploy.ts` in contracts/ after a deployment.
# Leave VITE_LOCKER_ADDRESS empty to run the in-memory demo ledger (development builds only; a production
# build with no address denies access to everyone).
# ---------------------------------------------------------------------------------------------------------
VITE_LOCKER_ADDRESS=
VITE_CHAIN_ID=11155111
VITE_LOCKER_DEPLOY_BLOCK=
# Optional. Defaults to the Sepolia or Mainnet Etherscan for those chain ids.
VITE_EXPLORER_URL=
