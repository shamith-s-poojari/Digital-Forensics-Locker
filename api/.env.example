# API environment. Copy to .env (git-ignored) and fill in. Names and placeholders only: never commit values.
# The process refuses to start if a required variable is missing or invalid.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Addresses of the reverse proxies allowed to set X-Forwarded-For / -Host / -Proto: IPs, CIDR ranges, or the
# keywords loopback, linklocal, uniquelocal, comma-separated (for example 10.0.0.0/8,loopback).
# Leave empty when nothing sits in front of the API: forwarded headers are then ignored. The API port must
# not be reachable except through those proxies.
TRUST_PROXY=

# Runtime database role (least privilege, see docs/specs/phase1-02-database-schema.md).
# Example shape only: postgresql://fl_app:<password>@localhost:5432/forensics_locker
DATABASE_URL=

# Exact origin of the web app, no path or trailing slash.
WEB_ORIGIN=http://localhost:5173

# Used by the login spec (1.3). Leave empty until then.
SIWE_DOMAIN=
SIWE_ALLOWED_CHAIN_IDS=
SESSION_ABSOLUTE_TTL_MIN=480
SESSION_IDLE_TTL_MIN=30
